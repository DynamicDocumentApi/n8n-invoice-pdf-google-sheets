    {
      "parameters": {
        "jsCode": "// One item per sheet row of the invoices that were emailed, for the update step.\nreturn $('Group lines into invoices').all().flatMap((invoice) =>\n  invoice.json.row_numbers.map((row_number) => ({ json: { row_number, status: 'sent' } })),\n);\n"
      },
