        "sendTo": "={{ $('Group lines into invoices').item.json.customer_email }}",
        "subject": "=Invoice {{ $('Group lines into invoices').item.json.invoice.number }} from Brambleworth Design Studio",
        "emailType": "text",
        "message": "=Hello {{ $('Group lines into invoices').item.json.invoice.buyer.name }},\n\nplease find attached invoice {{ $('Group lines into invoices').item.json.invoice.number }}.\n\nKind regards\nBrambleworth Design Studio",
        "options": {
